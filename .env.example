# ============================================================
#  聊天室生产环境配置示例
#  用法：cp .env.example .env 后按需修改，或直接用环境变量
# ============================================================

# ---- 端口 ----
# 云主机/容器平台会注入 PORT，按平台给的值填即可
PORT=8000

# 监听地址。0.0.0.0 = 接受所有网卡（容器/云主机必须）
HOST=0.0.0.0

# 备用端口。部署环境通常只开放一个端口，设 0 关闭
ALT_PORT=0

# ---- 数据目录 ----
# 容器里建议挂载持久化卷，例如 /data
# 本地默认用项目下的 data/
DATA_DIR=./data
